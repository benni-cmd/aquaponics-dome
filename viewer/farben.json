    { "match": "^kabel_pvc$",                 "name": "Kabel",                     "farbe": "#232323", "glanz": 0,    "rauheit": 0.6 },
    { "match": "^(epdm|EPDM.*|Schaumband EPDM)$", "name": "EPDM (schwarz)",        "farbe": "#1e1e1e", "glanz": 0,    "rauheit": 0.8 },
    { "match": "^(pp|hdpe|pe|ps)$",           "name": "PP, PE, PS (hell)",         "farbe": "#e4e6e1", "glanz": 0,    "rauheit": 0.5 },
    { "match": "^(pa|pom)$",                  "name": "PA, POM",                   "farbe": "#e6e1d2", "glanz": 0,    "rauheit": 0.45 },
    { "match": "^gfk_komposit$",              "name": "GFK",                       "farbe": "#a6bfa8", "glanz": 0,    "rauheit": 0.55 },
    { "match": "^pumpengehaeuse$",            "name": "Pumpengehäuse",            "farbe": "#2a5da8", "glanz": 0.1,  "rauheit": 0.45 },
    { "match": "^(sonde_gehaeuse|Geraet dunkel)$", "name": "Sonde, Gerät (dunkel)", "farbe": "#363b41", "glanz": 0.1, "rauheit": 0.5 },
    { "match": "^geraete_gehaeuse$",          "name": "Gerätegehäuse",           "farbe": "#5d646b", "glanz": 0.1,  "rauheit": 0.5 },
    { "match": "^leiterplatte_fr4$",          "name": "Leiterplatte",              "farbe": "#2f6b3b", "glanz": 0,    "rauheit": 0.6 },
    { "match": "^Tuerblatt",                  "name": "Türblatt",                 "farbe": "#d8cfba", "glanz": 0,    "rauheit": 0.6 },
    { "match": "^Haut$",                      "name": "Haut (Figur)",              "farbe": "#e0b392", "glanz": 0,    "rauheit": 0.8 },
    { "match": "^Kleidung blau$",             "name": "Kleidung (Figur)",          "farbe": "#2f5fa8", "glanz": 0,    "rauheit": 0.85 },
    { "match": "^Weste orange$",              "name": "Weste (Figur)",             "farbe": "#ee7d1a", "glanz": 0,    "rauheit": 0.85 }
  ],
