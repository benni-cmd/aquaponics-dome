    { "match": "^holz",                       "name": "Holz",                      "farbe": "#c19a62", "glanz": 0,    "rauheit": 0.85 },
    { "match": "^(beton|Beton)",              "name": "Beton",                     "farbe": "#a3a39d", "glanz": 0,    "rauheit": 0.95 },
    { "match": "^blaehton$",                  "name": "Blähton",                  "farbe": "#b9774a", "glanz": 0,    "rauheit": 0.95 },
